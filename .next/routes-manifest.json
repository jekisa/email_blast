{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/admin/campaigns/[id]",
      "regex": "^/api/admin/campaigns/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/campaigns/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/campaigns/[id]/preview",
      "regex": "^/api/admin/campaigns/([^/]+?)/preview(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/campaigns/(?<nxtPid>[^/]+?)/preview(?:/)?$"
    },
    {
      "page": "/api/admin/campaigns/[id]/promo",
      "regex": "^/api/admin/campaigns/([^/]+?)/promo(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/campaigns/(?<nxtPid>[^/]+?)/promo(?:/)?$"
    },
    {
      "page": "/api/admin/campaigns/[id]/templates",
      "regex": "^/api/admin/campaigns/([^/]+?)/templates(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/campaigns/(?<nxtPid>[^/]+?)/templates(?:/)?$"
    },
    {
      "page": "/api/admin/dispatches/[id]",
      "regex": "^/api/admin/dispatches/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/dispatches/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/auth/[...all]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPall": "nxtPall"
      },
      "namedRegex": "^/api/auth/(?<nxtPall>.+?)(?:/)?$"
    },
    {
      "page": "/api/track/[dispatchId]",
      "regex": "^/api/track/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPdispatchId": "nxtPdispatchId"
      },
      "namedRegex": "^/api/track/(?<nxtPdispatchId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/admin/assets",
      "regex": "^/api/admin/assets(?:/)?$",
