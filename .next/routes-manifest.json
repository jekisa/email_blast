      "namedRegex": "^/api/admin/assets(?:/)?$"
    },
    {
      "page": "/api/admin/campaigns",
      "regex": "^/api/admin/campaigns(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/campaigns(?:/)?$"
    },
    {
      "page": "/api/admin/customers",
      "regex": "^/api/admin/customers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/customers(?:/)?$"
    },
    {
      "page": "/api/admin/dispatches",
      "regex": "^/api/admin/dispatches(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/dispatches(?:/)?$"
    },
    {
      "page": "/api/admin/dispatches/preview",
      "regex": "^/api/admin/dispatches/preview(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/dispatches/preview(?:/)?$"
    },
    {
      "page": "/api/admin/email/test",
      "regex": "^/api/admin/email/test(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/email/test(?:/)?$"
    },
    {
      "page": "/api/admin/exports/claims",
      "regex": "^/api/admin/exports/claims(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/exports/claims(?:/)?$"
    },
    {
      "page": "/api/admin/imports",
      "regex": "^/api/admin/imports(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/imports(?:/)?$"
    },
    {
      "page": "/api/cron/birthday-dispatch",
      "regex": "^/api/cron/birthday\\-dispatch(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/cron/birthday\\-dispatch(?:/)?$"
    },
    {
      "page": "/api/cron/birthday-email-test",
      "regex": "^/api/cron/birthday\\-email\\-test(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/cron/birthday\\-email\\-test(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/campaigns",
      "regex": "^/dashboard/campaigns(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/campaigns(?:/)?$"
    },
    {
      "page": "/dashboard/contacts",
      "regex": "^/dashboard/contacts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/contacts(?:/)?$"
    },
    {
      "page": "/dashboard/monitoring",
      "regex": "^/dashboard/monitoring(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/monitoring(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}