generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  role            String    @default("user")
  banned          Boolean   @default(false)
  banReason       String?
  banExpires      DateTime? @db.Timestamptz(6)
  username        String    @unique
  displayUsername String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  sessions        Session[]
  accounts        Account[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(6)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

model ImportBatch {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName      String     @map("file_name")
  fileHash      String     @unique @map("file_hash")
  importedCount Int        @default(0) @map("imported_count")
  rejectedCount Int        @default(0) @map("rejected_count")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  customers     Customer[]

  @@map("import_batches")
}

model Customer {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName      String?     @map("full_name")
  firstName     String?     @map("first_name")
  email         String
  birthDate     DateTime    @map("birth_date") @db.Date
  phone         String?
  city          String?
  countryCode   String?     @map("country_code")
  isActive      Boolean     @default(true) @map("is_active")
  isBlacklisted Boolean     @default(false) @map("is_blacklisted")
  source        String      @default("import")
  importBatchId String?     @map("import_batch_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  dispatches    BirthdayDispatch[]

  @@index([email])
  @@map("customers")
}

model Campaign {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  status            String                      @default("draft")
  sendOffsetDays    Int                         @default(0) @map("send_offset_days") @db.SmallInt
  sendTime          DateTime                    @default(dbgenerated("'00:00:00'::time")) @map("send_time") @db.Time(0)
  timezone          String                      @default("Asia/Jakarta")
  ctaLabel          String                      @default("Lihat informasi") @map("cta_label")
  ctaUrl            String                      @default("https://sanghyang.com/") @map("cta_url")
  whatsappPhone     String?                     @map("whatsapp_phone")
  whatsappPhone2    String?                     @map("whatsapp_phone_2")
  whatsappContactName  String?                  @map("whatsapp_contact_name")
  whatsappContactName2 String?                  @map("whatsapp_contact_name_2")
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  templates         CampaignTemplateVersion[]
  promos            Promo[]
  assets            CampaignAsset[]
  dispatches        BirthdayDispatch[]

  @@map("campaigns")
}

model CampaignTemplateVersion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  version    Int
  name       String?
  subject    String
  bodyHtml   String   @map("body_html")
  isActive   Boolean  @default(false) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
  @@map("campaign_template_versions")
}

model Promo {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId               String             @map("campaign_id") @db.Uuid
  title                    String
  description              String              @default("")
  terms                    String              @default("")
  codePrefix               String?             @map("code_prefix")
  validDaysAfterBirthday   Int                 @default(7) @map("valid_days_after_birthday") @db.SmallInt
  validDaysBeforeBirthday  Int                 @default(1) @map("valid_days_before_birthday") @db.SmallInt
  isActive                 Boolean             @default(true) @map("is_active")
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  campaign                 Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dispatches               BirthdayDispatch[]

  @@map("promos")
}

model CampaignAsset {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String?   @map("campaign_id") @db.Uuid
  bucketId   String    @default("birthday-campaign-assets") @map("bucket_id")
  objectPath String    @unique @map("object_path")
  publicUrl  String    @map("public_url")
  mimeType   String    @map("mime_type")
  byteSize   BigInt    @map("byte_size")
  altText    String    @default("") @map("alt_text")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@map("campaign_assets")
}

model BirthdayDispatch {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String          @map("customer_id") @db.Uuid
  campaignId    String          @map("campaign_id") @db.Uuid
  promoId       String?         @map("promo_id") @db.Uuid
  birthdayYear  Int             @map("birthday_year")
  scheduledAt   DateTime        @map("scheduled_at") @db.Timestamptz(6)
  status        String          @default("queued")
  claimedAt     DateTime?       @map("claimed_at") @db.Timestamptz(6)
  claimToken    String?         @map("claim_token") @db.Uuid
  acceptedAt    DateTime?       @map("accepted_at") @db.Timestamptz(6)
  smtpMessageId String?         @map("smtp_message_id")
  attemptCount  Int             @default(0) @map("attempt_count")
  errorMessage  String?         @map("error_message")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  campaign      Campaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  promo         Promo?          @relation(fields: [promoId], references: [id], onDelete: SetNull)
  events        DeliveryEvent[]

  @@unique([customerId, campaignId, birthdayYear])
  @@index([scheduledAt, status])
  @@map("birthday_dispatches")
}

model DeliveryEvent {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispatchId    String           @map("dispatch_id") @db.Uuid
  eventType     String           @map("event_type")
  occurredAt    DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  smtpMessageId String?          @map("smtp_message_id")
  details       Json             @default("{}")
  dispatch      BirthdayDispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)

  @@index([dispatchId, occurredAt])
  @@map("delivery_events")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor      String?
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
